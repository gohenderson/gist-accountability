<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Lets the screenshot workflow open these screens directly with
  `adb shell am start`. Release builds (the APK you install) keep them private.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      The Easy Connect experiment (Syncthing inside Gist): debug builds only. Release builds
      keep no internet permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Syncthing reaches the folders in PublicAppData by their path. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application android:networkSecurityConfig="@xml/network_security_config">
        <service
            android:name="dev.gist.checkin.SyncthingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <activity
            android:name="dev.gist.checkin.CheckinEditActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name="dev.gist.checkin.HistoryActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name="dev.gist.checkin.SettingsActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name="dev.gist.checkin.AboutActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name="dev.gist.checkin.StepEditActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name="dev.gist.checkin.LibraryActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name="dev.gist.checkin.CheckinActivity"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
