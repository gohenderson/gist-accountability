<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Show the alarm notification / full-screen check-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Ring at an exact time (USE_EXACT_ALARM is auto-granted on Android 13+). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Keep ringing in the background until answered. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- "Display over other apps": lets a ringing check-in come back to the front if you
         leave it (Android blocks background activity starts otherwise). Granted by you in
         Settings; Gist never draws overlay windows. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Re-schedule the alarm after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app ask to be excluded from battery optimization. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Scan a QR code / barcode to stop the alarm. Optional feature. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Optional place triggers ("when I arrive at the gym", "only when away from home"):
         Android's own location service, on the phone. "All the time" is needed to notice an
         arrival while Gist is closed. Nothing is sent anywhere. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Optional running triggers: the step counter ("physical activity"), watched by a
         foreground service of the "health" type while a check-in needs it. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Voice check-ins: recording a clip in the app (asked only when you tap Record). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Voice check-ins speak typed text with the phone's text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- The full-screen alarm setting, to open it by name from a notification. -->
        <intent>
            <action android:name="android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENT" />
            <data android:scheme="package" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!-- Note: no INTERNET permission. Nothing ever leaves the phone. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Gist">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The alarm screen opens in a task of its own (like the stock Clock app's), not on top
            of whatever Gist screen was open. Closing it on the lock screen (End test, or the
            last step) then just removes that task; before, it left the screen underneath (say,
            a check-in's page) stuck, blank and ignoring taps, after unlocking. Opened from
            History or "Do it now" (without NEW_TASK) it still opens in the app's own task.
        -->
        <activity
            android:name=".CheckinActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.gist.checkin.alarm"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".CheckinEditActivity"
            android:exported="false" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".LibraryActivity"
            android:exported="false" />

        <activity
            android:name=".StepEditActivity"
            android:exported="false" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".ProximityReceiver"
            android:exported="false" />

        <receiver
            android:name=".SoftAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".MovementService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
